# Database PostgreSQL Configuration
POSTGRES_DB=music_db
DB_USER=music_user
DB_PASS=YourStrongPasswordHere_2026!

# Cloudinary Storage Configuration
# Lấy URL này tại Cloudinary Dashboard (API Environment variable)
# Cú pháp: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz1@your-cloud-name

# SoundWave Initial Administrator Account (Auto-seeded & Synced on Startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecret2026!
